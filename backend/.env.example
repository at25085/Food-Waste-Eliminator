# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to backend/.env, then paste each value right after the "=". Blank = not used.
#  This template is committed; the real backend/.env is git-ignored. Never put keys in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED TO GO LIVE ──────────────────────────────────────────────────────

# Tiger Cloud (Tiger Data) → your service → "Connection info" → Service URL.
# Paste it exactly as shown (postgres://tsdbadmin:…@….tsdb.cloud.timescale.com:…/tsdb?sslmode=require).
# Leave blank for laptop runs (uses the local SQLite file).
DATABASE_URL=

# A long random password you make up. Locks uploads / retrain / rollback.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Open the dashboard once with  https://yourdomain/?token=THIS_VALUE  and the browser remembers it.
# Leave blank on your laptop if you don't want the lock while testing.
API_TOKEN=

# Your .tech domain, e.g. wasteless.tech (after pointing its A record at the Vultr server's IP).
DOMAIN=

# The product's final name, shown in the header and page titles.
APP_DISPLAY_NAME=

# ── OPTIONAL (each one is a prize track; the app works without them) ─────────

# Google AI Studio → "Get API key". Writes the morning briefing.
GEMINI_API_KEY=

# Backboard.io → API keys. Remembers manager notes.
BACKBOARD_API_KEY=
