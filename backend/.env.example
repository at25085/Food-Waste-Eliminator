# Copy to backend/.env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ELEVENLABS_API_KEY=
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db   # Tiger Cloud / Timescale
# APP_DISPLAY_NAME=YourNewName
MONGODB_URI=               # MongoDB Atlas connection string (model cards)
BACKBOARD_API_KEY=         # Backboard.io persistent memory (manager notes)
DOMAIN=                    # e.g. yourname.tech (Caddy gets HTTPS automatically)
